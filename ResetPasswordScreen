import React, { useState } from 'react';
import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  StyleSheet,
  Alert,
  ActivityIndicator,
  SafeAreaView,
  StatusBar,
} from 'react-native';
import Icon from 'react-native-vector-icons/Feather';
import auth from '@react-native-firebase/auth';
import {
  getFirestore,
  collection,
  query,
  where,
  getDocs,
} from '@react-native-firebase/firestore';

export default function ForgotPasswordScreen({ navigation }) {
  const [email, setEmail] = useState('');
  const [loading, setLoading] = useState(false);

  const isEmail = value => {
    return value.includes('@');
  };

  const handleSendCode = async () => {
    const value = email.trim();

    if (!value) {
      Alert.alert('تنبيه', 'يرجى إدخال رقم الجوال أو البريد الإلكتروني.');
      return;
    }

    setLoading(true);

    try {
      const db = getFirestore();
      const usersRef = collection(db, 'Users');

      let q;

      if (isEmail(value)) {
        q = query(usersRef, where('email', '==', value));
      } else {
        q = query(usersRef, where('phone', '==', value));
      }

      const snapshot = await getDocs(q);

      if (snapshot.empty) {
        Alert.alert('خطأ', 'المستخدم غير موجود في النظام');
        setLoading(false);
        return;
      }

      if (isEmail(value)) {
        await auth().sendPasswordResetEmail(value);

        Alert.alert(
          'تم',
          'تم إرسال رابط استعادة كلمة المرور إلى بريدك الإلكتروني.'
        );
      } else {
        const confirmation = await auth().signInWithPhoneNumber(value);

        navigation.navigate('otp', {
          confirmation,
          phoneNumber: value,
        });
      }
    } catch (error) {
      console.log('Forgot password error:', error);

      let errorMessage = 'حدث خطأ، حاول مرة أخرى';

      if (error.code === 'auth/invalid-email') {
        errorMessage = 'البريد الإلكتروني غير صحيح';
      } else if (error.code === 'auth/user-not-found') {
        errorMessage = 'البريد الإلكتروني غير مسجل';
      } else if (error.code === 'auth/invalid-phone-number') {
        errorMessage = 'رقم الجوال غير صحيح';
      } else if (error.code === 'auth/too-many-requests') {
        errorMessage = 'تمت محاولات كثيرة، حاول لاحقًا';
      }

      Alert.alert('خطأ', errorMessage);
    } finally {
      setLoading(false);
    }
  };

  return (
    <View style={styles.screen}>
      <StatusBar barStyle="dark-content" backgroundColor="#6CAF75" />

      <SafeAreaView style={styles.greenSection}>
        <TouchableOpacity
          onPress={() => navigation.navigate('signin')}
          style={styles.backButton}
          activeOpacity={0.8}
        >
          <Icon name="arrow-left" size={20} color="#111" />
        </TouchableOpacity>

        <View style={styles.headerContent}>
          <Text style={styles.headerText}>استعادة كلمة المرور</Text>

          <Text style={styles.subText}>
            الرجاء ادخال رقم الجوال أو البريد الإلكتروني
          </Text>
          <Text style={styles.subText}>لإرسال رمز التحقق</Text>
        </View>
      </SafeAreaView>

      <View style={styles.whiteSection}>
        <View style={styles.inputWrapper}>
          <View style={styles.rightIcons}>
            <Icon name="phone" size={17} color="#222" />
            <Icon name="mail" size={17} color="#222" style={styles.mailIcon} />
          </View>

          <TextInput
            style={styles.input}
            placeholder="رقم الجوال أو البريد الإلكتروني"
            placeholderTextColor="#B8B8B8"
            value={email}
            onChangeText={setEmail}
            textAlign="right"
            keyboardType="default"
            autoCapitalize="none"
          />
        </View>

        <TouchableOpacity
          style={styles.verifyButton}
          onPress={handleSendCode}
          disabled={loading}
          activeOpacity={0.85}
        >
          {loading ? (
            <ActivityIndicator color="#fff" />
          ) : (
            <Text style={styles.verifyButtonText}>إرسال رمز التحقق</Text>
          )}
        </TouchableOpacity>

        <View style={styles.bottomArea}>
          <View style={styles.divider} />
          <TouchableOpacity onPress={() => navigation.navigate('signin')}>
            <Text style={styles.backToLoginText}>عودة إلى تسجيل الدخول</Text>
          </TouchableOpacity>
        </View>
      </View>
    </View>
  );
}

