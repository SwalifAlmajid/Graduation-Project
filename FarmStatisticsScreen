import React, { useEffect, useState } from 'react';
import {
  View,
  Text,
  StyleSheet,
  TouchableOpacity,
  ScrollView,
  StatusBar,
  ActivityIndicator,
  Alert,
} from 'react-native';
import Ionicons from 'react-native-vector-icons/Ionicons';
import MaterialIcons from 'react-native-vector-icons/MaterialIcons';
import Feather from 'react-native-vector-icons/Feather';
import Entypo from 'react-native-vector-icons/Entypo';
import FontAwesome5 from 'react-native-vector-icons/FontAwesome5';
import { SafeAreaView } from 'react-native-safe-area-context';

import { getAuth, onAuthStateChanged, signOut } from '@react-native-firebase/auth';
import {
  getFirestore,
  doc,
  onSnapshot,
} from '@react-native-firebase/firestore';

const Colors = {
  primary: '#72B67A',
  white: '#F7F7F7',
  card: '#FFFFFF',
  text: '#2E2E2E',
  muted: '#8F96A3',
  lightGreen: '#D9F0DD',
  greenDark: '#2F8A57',
  border: '#E9E9E9',
  iconGreen: '#BFE5C6',
  iconBlue: '#D7E5FF',
  iconPurple: '#E8D8FA',
  iconYellow: '#F6E7A9',
  bottomIcon: '#9CA3AF',
};

const StatCard = ({ iconBg, icon, title, subtitle, onPress }) => (
  <TouchableOpacity style={styles.statCard} activeOpacity={0.85} onPress={onPress}>
    <View style={[styles.smallIconWrap, { backgroundColor: iconBg }]}>
      {icon}
    </View>
    <Text style={styles.statTitle}>{title}</Text>
    <Text style={styles.statSubtitle}>{subtitle}</Text>
  </TouchableOpacity>
);

export default function App({ navigation }) {
  const [initializing, setInitializing] = useState(true);
  const [firebaseUser, setFirebaseUser] = useState(null);
  const [farmData, setFarmData] = useState({
    name: '...',
    farmName: '...',
    city: '',
    rating: 0,
    reviewsCount: 0,
    monthlySales: 0,
  });

  useEffect(() => {
    const auth = getAuth();

    const unsubscribeAuth = onAuthStateChanged(auth, user => {
      setFirebaseUser(user);
      if (initializing) setInitializing(false);

      if (!user) {
        setFarmData({
          name: 'زائر',
          farmName: 'لا توجد مزرعة',
          city: '',
          rating: 0,
          reviewsCount: 0,
          monthlySales: 0,
        });
      }
    });

    return unsubscribeAuth;
  }, [initializing]);

  useEffect(() => {
    if (!firebaseUser?.uid) return;

    const db = getFirestore();
    const farmerRef = doc(db, 'farmers', firebaseUser.uid);

    const unsubscribeSnapshot = onSnapshot(
      farmerRef,
      snapshot => {
        if (snapshot.exists()) {
          const data = snapshot.data();

          setFarmData({
            name: data.name || 'بدون اسم',
            farmName: data.farmName || 'بدون اسم مزرعة',
            city: data.city || '',
            rating: data.rating || 0,
            reviewsCount: data.reviewsCount || 0,
            monthlySales: data.monthlySales || 0,
          });
        } else {
          setFarmData({
            name: firebaseUser.displayName || 'مستخدم جديد',
            farmName: 'مزرعتي',
            city: '',
            rating: 0,
            reviewsCount: 0,
            monthlySales: 0,
          });
        }
      },
      error => {
        console.log('Firestore error:', error);
        Alert.alert('خطأ', 'تعذر جلب بيانات المزرعة من Firebase');
      }
    );

    return unsubscribeSnapshot;
  }, [firebaseUser]);

  const handleLogout = async () => {
    try {
      await signOut(getAuth());
      Alert.alert('تم', 'تم تسجيل الخروج');
      if (navigation) {
        navigation.navigate('Login');
      }
    } catch (error) {
      Alert.alert('خطأ', error.message);
    }
  };

  const formatCurrency = value => {
    return new Intl.NumberFormat('ar-SA').format(value);
  };

  if (initializing) {
    return (
      <View style={styles.loaderContainer}>
        <ActivityIndicator size="large" color={Colors.greenDark} />
      </View>
    );
  }

  return (
    <View style={styles.screen}>
      <StatusBar barStyle="dark-content" backgroundColor={Colors.primary} />

      <SafeAreaView edges={['top']} style={styles.topSafeArea}>
        <View style={styles.greenHeader}>
          <View style={styles.headerRow}>
            <View style={styles.leftSide}>
              <TouchableOpacity
                style={styles.backBtn}
                onPress={() => navigation?.goBack?.()}
              >
                <Feather name="arrow-left" size={18} color="#1f2937" />
              </TouchableOpacity>

              <TouchableOpacity style={styles.notifyBtn}>
                <Ionicons name="notifications" size={16} color="#fff" />
              </TouchableOpacity>
            </View>

            <View style={styles.rightSide}>
              <Text style={styles.brandText}>حصاد</Text>

              <TouchableOpacity style={styles.leafBtn}>
                <Ionicons name="leaf" size={16} color="#fff" />
              </TouchableOpacity>
            </View>
          </View>
        </View>
      </SafeAreaView>

      <View style={styles.contentShell}>
        <ScrollView
          contentContainerStyle={styles.scrollContent}
          showsVerticalScrollIndicator={false}
        >
          <View style={styles.welcomeCard}>
            <View style={styles.welcomeTop}>
              <View style={styles.welcomeTextWrap}>
                <Text style={styles.welcomeTitle}>أهلاً بك {farmData.name}</Text>
                <Text style={styles.farmName}>
                  {farmData.farmName}
                  {farmData.city ? ` - ${farmData.city}` : ''}
                </Text>
                <Text style={styles.ratingText}>
                  {farmData.rating} ⭐ ({farmData.reviewsCount} تقييم)
                </Text>
              </View>

              <View style={styles.avatarCircle}>
                <Ionicons name="person" size={24} color={Colors.primary} />
              </View>
            </View>

            <View style={styles.salesBox}>
              <Text style={styles.salesLabel}>إجمالي المبيعات هذا الشهر</Text>
              <Text style={styles.salesValue}>
                {formatCurrency(farmData.monthlySales)} ريال
              </Text>
            </View>
          </View>

          <View style={styles.grid}>
            <StatCard
              iconBg={Colors.iconGreen}
              icon={
                <MaterialIcons
                  name="history"
                  size={22}
                  color={Colors.greenDark}
                />
              }
              title="الطلبات السابقة"
              subtitle="تاريخ المبيعات"
              onPress={() => navigation?.navigate?.('OrdersHistory')}
            />

            <StatCard
              iconBg={Colors.iconBlue}
              icon={<Entypo name="tag" size={20} color="#3B82F6" />}
              title="العروض الحالية"
              subtitle="إدارة منتجاتك"
              onPress={() => navigation?.navigate?.('Offers')}
            />

            <StatCard
              iconBg={Colors.iconPurple}
              icon={<Feather name="edit-2" size={20} color="#9333EA" />}
              title="تعديل المزرعة"
              subtitle="بيانات المزرعة"
              onPress={() => navigation?.navigate?.('EditFarm')}
            />

            <StatCard
              iconBg={Colors.iconYellow}
              icon={<Ionicons name="star" size={20} color="#D4A400" />}
              title="التقييمات"
              subtitle="آراء العملاء"
              onPress={() => navigation?.navigate?.('Reviews')}
            />
          </View>

          <TouchableOpacity style={styles.logoutBtn} onPress={handleLogout}>
            <Text style={styles.logoutText}>تسجيل الخروج</Text>
          </TouchableOpacity>
        </ScrollView>

        <SafeAreaView edges={['bottom']} style={styles.bottomSafeArea}>
          <View style={styles.bottomBar}>
            <TouchableOpacity style={styles.bottomItem}>
              <Ionicons name="person" size={20} color={Colors.greenDark} />
              <Text style={[styles.bottomLabel, styles.activeBottomLabel]}>
                الحساب
              </Text>
            </TouchableOpacity>

            <TouchableOpacity style={styles.bottomItem}>
              <MaterialIcons
                name="bar-chart"
                size={20}
                color={Colors.bottomIcon}
              />
              <Text style={styles.bottomLabel}>الإحصائيات</Text>
            </TouchableOpacity>

            <TouchableOpacity style={styles.bottomItem}>
              <Entypo name="tag" size={20} color={Colors.bottomIcon} />
              <Text style={styles.bottomLabel}>العروض</Text>
            </TouchableOpacity>

            <TouchableOpacity style={styles.bottomItem}>
              <FontAwesome5
                name="home"
                size={18}
                color={Colors.bottomIcon}
              />
              <Text style={styles.bottomLabel}>الرئيسية</Text>
            </TouchableOpacity>
          </View>
        </SafeAreaView>
      </View>
    </View>
  );
}

